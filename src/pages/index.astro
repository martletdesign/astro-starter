---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Martlet source baseline · Overview">
  <div class="home-editorial">
    <section class="home-hero" aria-labelledby="home-identity"><div class="home-hero__top home-wrap">
      <div class="home-hero__identity"><img class="home-hero__arms" src="/assets/mark.svg" width="512" height="512" alt="Martlet Design gold martlet on blue" fetchpriority="high"/></div>
      <div class="home-hero__copy"><h1 id="home-identity"><span class="home-hero__prelude">A working language</span><span class="home-hero__statement">Clear Structure<br/> for Real Work</span><span class="home-hero__coda">An Astro source specimen</span></h1>
        <p>Representative publishing, research, and application content exercising the original website's composition.</p>
        <div class="home-hero__actions"><a class="home-action" href="#home-latest-writing">Read an example <span aria-hidden="true">↓</span></a><a class="home-text-link" href="#home-projects">Explore patterns <span aria-hidden="true">↘</span></a></div>
      </div>
      <div class="home-hero__foot"><span>Design reference · Fictional content</span><span aria-hidden="true">Scroll to explore ↓</span></div>
    </div></section>
    <section class="home-writing home-section" data-home-section="blog" aria-labelledby="home-latest-writing"><div class="home-wrap">
      <div class="home-section-head"><div><p class="home-kicker">Writing and records</p><h2 id="home-latest-writing">From the archive</h2></div><a class="home-text-link" href="/article/">Read the article <span aria-hidden="true">→</span></a></div>
      <div class="home-writing__layout">
        <article class="home-writing__lead"><a href="/article/" aria-labelledby="home-lead-title"><div class="home-writing__image"><img src="/assets/neutral-landscape.svg" alt="" loading="lazy"/></div><div class="home-writing__lead-copy"><time class="home-date" datetime="2026-10-01">Oct 1, 2026</time><h3 id="home-lead-title">A field note on the shape of evidence</h3><p>A substantial summary provides a representative measure and tests paragraph wrapping.</p><span class="home-read-link">Read the essay <span aria-hidden="true">→</span></span></div></a></article>
        <div class="home-writing__recent"><p class="home-kicker">More recent writing</p><ol><li><article><a href="/document/"><time class="home-date" datetime="2026-09-14">Sep 14, 2026</time><h3>A documented method for a difficult question</h3><p>Supporting material for a technical report.</p><span class="home-read-link">Read <span aria-hidden="true">→</span></span></a></article></li><li><article><a href="/article/"><time class="home-date" datetime="2026-08-05">Aug 5, 2026</time><h3>Notes from a longer investigation</h3><span class="home-read-link">Read <span aria-hidden="true">→</span></span></a></article></li></ol></div>
      </div>
    </div></section>
    <section class="home-projects home-section" data-home-section="projects" aria-labelledby="home-projects"><div class="home-wrap home-projects__heading"><p class="home-kicker">Applied examples</p><h2 id="home-projects">Selected projects</h2></div>
      <article class="home-history"><img class="home-history__art" src="/assets/neutral-landscape.svg" alt="" loading="lazy"/><div class="home-wrap home-history__inner"><div class="home-history__copy"><p class="home-kicker">Field research</p><h3><span class="home-history__year">2026</span> <span>Northlight Survey</span></h3><p>Illustrative exploration of an evidence-driven project with longer descriptive text.</p><a class="home-action" href="/document/">Read the report <span aria-hidden="true">↗</span></a></div></div></article>
      <div class="home-project-notes home-wrap"><article><p class="home-kicker">Experimental methods</p><h3><a href="/article/">A small computational notebook <span aria-hidden="true">↗</span></a></h3><p>Representative technical work, without institution-specific claims.</p></article></div>
    </section>
    <nav class="home-destinations home-wrap" aria-label="Reference compositions"><a href="/article/"><span>Article <span aria-hidden="true">↗</span></span><p>Typography, tables, quotations, and editorial material.</p></a><a href="/document/"><span>Document <span aria-hidden="true">↗</span></span><p>Long-form reading, a sticky contents rail, and figures.</p></a></nav>
    <section class="home-subjects home-section" data-home-section="subjects" aria-labelledby="home-subjects"><div class="home-wrap home-subjects__layout"><div class="home-subjects__intro"><p class="home-kicker">Find your way in</p><h2 id="home-subjects">Explore<br/> by subject</h2></div><ul class="home-subject-index"><li><a href="/article/"><span>Writing</span><span aria-hidden="true">↗</span></a></li><li><a href="/document/"><span>Research</span><span aria-hidden="true">↗</span></a></li><li><a href="/article/#forms"><span>Interfaces</span><span aria-hidden="true">↗</span></a></li></ul></div></section>
  </div>
</BaseLayout>
