---
const otherSites=[{title:'Editorial example',url:'/article/'},{title:'Document example',url:'/document/'}];
const notices=[{title:'About this reference',url:'/document/'}];
const socialMedia=[{name:'Example link',url:'/article/'}];
const sitePath=(value)=>value;
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div><h2>Other Sites</h2><ul>{otherSites.map((item:any)=><li><a href={item.url} target={item.target} rel={item.target ? 'noopener noreferrer' : undefined}>{item.title}</a></li>)}</ul></div>
    <div><h2>Notices</h2><ul>{notices.map((item:any)=><li><a href={sitePath(item.url)} data-cookie-preferences={undefined}>{item.title}</a></li>)}</ul></div>
    <div><h2>Resources</h2><ul class="social-list">{socialMedia.map((item:any)=><li><a href={item.url} rel="noopener">{item.name}</a></li>)}</ul></div>
  </div>
  <div class="container footer-bottom"><a class="footer-identity" href="/" aria-label="Martlet Design home"><img src="/assets/mark.svg" alt=""><span><strong>Martlet Design</strong><br>A design-language reference site</span></a><p>Reference fixture · {new Date().getUTCFullYear()}</p></div>
</footer>
